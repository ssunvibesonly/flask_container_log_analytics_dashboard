---
alwaysApply: true
---

# ==============================
# Architecture
# ==============================

# Flask 앱은 반드시 app factory 패턴(create_app)을 사용해야 한다
always_use_app_factory: true

# 모든 라우트는 Blueprint로 그룹화해야 한다
require_blueprints_for_routes: true

# 단일 파일(app.py 하나)에 모든 Flask 코드를 작성하는 것을 금지한다
forbid_single_file_flask_app: true


# ==============================
# Code Structure
# ==============================

# 하나의 함수는 최대 40줄을 넘지 않도록 한다
max_function_length: 40

# 동작이 숨겨진 매직 추상화보다, 명시적이고 읽기 쉬운 코드를 선호한다
prefer_explicit_over_magic: true

# 상속 구조가 깊어지는 것을 금지한다 (2단계 이상 상속 지양)
forbid_deep_inheritance: true


# ==============================
# Naming Convention
# ==============================

# 변수명과 함수명은 camelCase를 사용한다
# (예: logEvent, fetchDailyStats)
variable_naming_convention: camelCase


# ==============================
# Error Handling
# ==============================

# 예외 처리는 반드시 try/catch(try/except) 블록을 사용해 명시적으로 처리한다
# 예외를 암묵적으로 무시하거나 pass 처리하는 것을 금지한다
require_try_catch_for_error_handling: true


# ==============================
# Database
# ==============================

# 데이터베이스 접근은 SQLAlchemy ORM만 사용한다
use_sqlalchemy_orm_only: true

# Raw SQL 사용 시 반드시 주석으로 사용 이유를 명시해야 한다
forbid_raw_sql_without_comment: true


# ==============================
# Testing
# ==============================

# 테스트 프레임워크는 pytest만 사용한다
testing_framework: pytest

# 핵심 로직(파서, 집계 로직 등)에 대해서는 테스트 작성을 필수로 한다
require_tests_for_core_logic: true


# ==============================
# Style & Readability
# ==============================

# 불필요한 추상화(helper, util 남발)를 지양한다
avoid_over_abstraction: true

# 기교적인 코드보다 가독성을 우선한다
prefer_readability_over_cleverness: true


# ==============================
# Comments & Documentation
# ==============================

# 모든 코드 주석은 한국어로 작성한다
# (함수의 역할, 중요한 판단 이유를 설명하는 용도로 사용)
comments_language: ko
